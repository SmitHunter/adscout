# Copy to .env and uncomment what you need. Every value is optional.
# Values saved on the Settings screen take priority over this file.

# Meta Ad Library API access token: enables EU and UK keyword searches through the
# official API. US, AU, CA and other countries always use the web scraper.
# META_ACCESS_TOKEN=

# Anthropic API key for Claude angle analysis. Without it, AdScout uses Claude Code.
# ANTHROPIC_API_KEY=

# Run the scraper browser without a window (true/false)
HEADLESS=false

# Timezone for report dates and the daily watchlist check (IANA name)
TIMEZONE=Australia/Melbourne

# Where the database, media and browser profile live
# DATA_DIR=data
